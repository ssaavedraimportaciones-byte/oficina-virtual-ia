# --- Motor de IA ---
# Alcanza con configurar UNO de los dos proveedores.
# Si cargás los dos, LLM_PROVIDER define cuál se usa (por defecto, anthropic).
# LLM_PROVIDER=anthropic | openai
LLM_PROVIDER=

# Opción A — Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Opción B — OpenAI (platform.openai.com)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Seguridad (obligatorio en producción) ---
# Cifra los tokens de Meta guardados. Sin esto no se pueden conectar canales.
# Generala con: openssl rand -hex 32
ENCRYPTION_KEY=

# App Secret de tu app de Meta. Se usa para verificar la firma de los webhooks.
# Sin esto los webhooks se rechazan, para que nadie inyecte mensajes falsos.
META_APP_SECRET=

# --- Canales ---
# WhatsApp Cloud API (Meta) — el panel > Conexiones explica cómo completarlo
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Instagram Messaging (Meta Graph API, misma app que WhatsApp)
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_PAGE_ID=

# --- Acceso a los paneles — sin esto quedan bloqueados ---
# ADMIN_PASSWORD entra a /admin y también a /panel
ADMIN_PASSWORD=
# PANEL_PASSWORD (opcional) da acceso solo a /panel, para tu equipo
PANEL_PASSWORD=

# --- App ---
NEXT_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AgentsApp
