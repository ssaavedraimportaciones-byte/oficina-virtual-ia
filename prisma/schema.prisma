generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Usuarios y sesiones ---
// Reemplaza la contraseña única compartida por cuentas individuales. Un
// PLATFORM_ADMIN ve /admin y todos los negocios; un USER normal solo entra a
// los negocios donde tiene una fila en BusinessMember.
enum SystemRole {
  PLATFORM_ADMIN
  USER
}

/// Se diferencian por cuántos negocios propios permite cada uno (ver
/// lib/plans.ts): FREE y BASICO hasta 1, NEGOCIOS hasta 3, ILIMITADO sin
/// límite. Un PLATFORM_ADMIN no está sujeto a esto (ve/gestiona todo
/// independientemente del plan).
enum Plan {
  FREE
  BASICO
  NEGOCIOS
  ILIMITADO
}

/// Cuánto cuesta dejar operativo el PRIMER local de un cliente (ver
/// lib/plans.ts): según qué activa (un solo canal sin cobros, o agenda/carta
/// con cobros, o mesas + pedidos + cobros + varios canales). Un local
/// adicional del mismo cliente siempre paga el precio plano de adicional,
/// sin importar este nivel. Lo fija el administrador según lo que configura.
enum SetupTier {
  SIMPLE
  ESTANDAR
  AVANZADO
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  passwordHash    String
  role            SystemRole @default(USER)
  /// null = todavía no confirmó que la casilla es suya. No bloquea el login
  /// (no hay forma de garantizar que todo despliegue tenga SMTP configurado),
  /// pero importa antes de confiarle un envío de recuperación de contraseña.
  emailVerifiedAt DateTime?
  /// Cuándo aceptó los términos y la política de privacidad al registrarse.
  /// null = la cuenta la creó un administrador (no pasó por el registro).
  termsAcceptedAt DateTime?
  createdAt       DateTime   @default(now())

  plan                 Plan    @default(FREE)
  stripeCustomerId     String?
  stripeSubscriptionId String?

  /// Secreto TOTP cifrado (ver lib/secrets.ts). null = 2FA desactivado.
  totpSecret    String?
  totpEnabledAt DateTime?

  sessions    Session[]
  memberships BusinessMember[]
  authTokens  AuthToken[]
  subscriptions Subscription[]
  payments      Payment[]
  invoices      Invoice[]

  @@map("users")
}

model Session {
  /// Se guarda el hash del token, no el token: un volcado de la base no
  /// alcanza para robar sesiones activas.
  tokenHash String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  /// Solo para mostrarle a la persona "esta sesión es tu celular / esta es
  /// tu notebook" en /account. No se usa para ninguna decisión de seguridad
  /// (un IP/user-agent se falsifican fácil).
  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Tokens de un solo uso enviados por email: recuperar contraseña o
/// verificar la casilla. Un mismo modelo para los dos porque el ciclo de
/// vida es idéntico (crear, mandar por mail, consumir una vez, expira).
enum AuthTokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFY
}

model AuthToken {
  /// Se guarda el hash del token (va en el link del mail), no el token: un
  /// volcado de la base no alcanza para generar links de recuperación.
  tokenHash String           @id
  userId    String
  purpose   AuthTokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

/// Intentos de login fallidos, para el límite de fuerza bruta. Antes vivía en
/// un Map en memoria: no sobrevivía a un restart ni se compartía entre
/// instancias. Cada intento fallido es una fila; se cuentan las de la
/// ventana de tiempo vigente y se podan las viejas al mismo tiempo.
model RateLimitHit {
  id        String   @id @default(uuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@map("rate_limit_hits")
}

enum BusinessRole {
  OWNER
  STAFF
}

model BusinessMember {
  id         String       @id @default(uuid())
  userId     String
  businessId String
  role       BusinessRole @default(OWNER)
  createdAt  DateTime     @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId])
  @@map("business_members")
}

// --- Negocios ---

model Business {
  id         String   @id @default(uuid())
  templateId String

  // Configuración del agente (antes AgentConfig embebido).
  agentName    String
  businessName String
  industry     String
  description  String
  goals        String
  tone         String
  channels     String[]
  configuredAt DateTime @default(now())

  // Credenciales de canal. Los tokens se guardan cifrados (ver lib/secrets.ts)
  // antes de llegar acá: esta tabla nunca ve el texto plano.
  /// Notas internas del dueño de la plataforma sobre esta empresa. Nunca se
  /// muestran ni se envían al panel de la empresa (ver lib/platform.ts).
  adminNotes String @default("")
  /// Límite mensual de respuestas del agente fijado a mano para esta empresa.
  /// null = vale el del plan.
  replyLimitOverride Int?
  /// RUT de la empresa cliente, para facturar y para sistemas externos
  /// (API v1). Lo carga el administrador; los clientes no lo ven editable.
  rut String?
  /// Cuándo se pagó el cobro único de implementación DE ESTE NEGOCIO (conectar
  /// su número, cargar su información). Es por negocio, no por cliente: quien
  /// maneja 2 negocios paga la implementación 2 veces. null = todavía no.
  setupFeePaidAt DateTime?
  /// Nivel de la implementación del primer local (ver SetupTier). No afecta
  /// a locales adicionales del mismo cliente, que siempre pagan el precio
  /// plano de adicional.
  setupTier SetupTier @default(ESTANDAR)

  // Únicos: todos los números de todas las empresas llegan al mismo webhook y
  // se reparten por este ID; si dos empresas tuvieran el mismo, los mensajes
  // de una le llegarían a la otra.
  whatsappPhoneNumberId String? @unique
  whatsappAccessToken   String?
  instagramPageId       String? @unique
  instagramAccessToken  String?

  /// WeekHours: array de 7 posiciones (dom=0..sáb=6), cada una
  /// {open,close} o null si ese día está cerrado.
  hours Json

  createdAt DateTime @default(now())

  members       BusinessMember[]
  conversations Conversation[]
  knowledge     KnowledgeEntry[]
  services      Service[]
  appointments  Appointment[]
  products      Product[]
  orders        Order[]
  floors        Floor[]
  professionals Professional[]
  reservations  TableReservation[]
  logo          BusinessLogo?
  sales         SalesSettings?

  /// Cuánto se guarda una mesa por reserva, en minutos.
  reservationMinutes Int @default(120)
  /// Tolerancia: si el cliente no llegó pasados estos minutos de la hora
  /// reservada, la mesa se libera. El agente se lo avisa al confirmar.
  reservationGraceMinutes Int @default(15)

  @@map("businesses")
}

// --- Conversaciones ---

model Conversation {
  id            String   @id @default(uuid())
  businessId    String
  channel       String
  contactName   String
  contactHandle String
  status        String   @default("abierta")
  notes         String   @default("")
  /// Una persona del equipo tomó la conversación (o el agente la derivó): el
  /// agente no contesta hasta que alguien la vuelva a activar desde el panel.
  agentPaused   Boolean  @default(false)
  /// Por qué se derivó, para que quien la toma sepa qué pasó sin leer todo.
  handoffReason String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([businessId, channel, contactHandle])
  @@index([businessId, updatedAt])
  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  sender         String
  text           String
  /// ID del mensaje en WhatsApp/Instagram. Meta reintenta el webhook si tarda
  /// en recibir el 200: con esto el mismo mensaje no se procesa dos veces
  /// (dos respuestas, dos pedidos, dos turnos).
  externalId     String?  @unique
  timestamp      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, timestamp])
  @@map("messages")
}

// --- Base de conocimiento ---

model KnowledgeEntry {
  id         String   @id @default(uuid())
  businessId String
  title      String
  content    String
  sourceType String
  sourceUrl  String?
  updatedAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("knowledge_entries")
}

// --- Agenda ---

model Service {
  id              String @id @default(uuid())
  businessId      String
  name            String
  durationMinutes Int
  price           String

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([businessId])
  @@map("services")
}

model Appointment {
  id             String   @id @default(uuid())
  businessId     String
  conversationId String?
  serviceId      String?
  serviceName    String
  /// Quién atiende (null = el negocio no maneja personal, o cualquiera).
  professionalId   String?
  professionalName String?
  contactName    String
  contactHandle  String
  /// Fecha y hora local del negocio sin zona horaria ("2026-08-07T14:00"),
  /// a propósito: ver la nota en lib/types.ts sobre por qué no es DateTime.
  startsAt        String
  durationMinutes Int
  status          String   @default("confirmado")
  createdAt       DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service  Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)

  @@index([businessId, startsAt])
  @@map("appointments")
}

/// Una persona del equipo que atiende (peluquera, manicurista, dentista, mesero...).
/// Sin ninguna cargada, el negocio funciona con una sola agenda, como siempre.
model Professional {
  id         String   @id @default(uuid())
  businessId String
  name       String
  createdAt  DateTime @default(now())

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([businessId])
  @@map("professionals")
}

// --- Mesas y reservas (restaurantes) ---

/// Un piso o salón del local, con su croquis. Las coordenadas de los elementos
/// van en unidades del lienzo (width x height), no en píxeles de pantalla.
model Floor {
  id         String @id @default(uuid())
  businessId String
  name       String
  position   Int    @default(0)
  width      Int    @default(1000)
  height     Int    @default(600)

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  elements FloorElement[]

  @@index([businessId])
  @@map("floors")
}

/// Todo lo que se dibuja en un piso: mesas, ventanas, puertas, barra, muros
/// y zonas (un área con nombre, como "Terraza"). Solo las mesas se reservan.
model FloorElement {
  /// Lo genera el navegador al dibujar: así el croquis se guarda entero de una.
  id       String @id
  floorId  String
  kind     String
  label    String
  x        Int
  y        Int
  width    Int
  height   Int
  /// "rect" o "round" (solo mesas).
  shape    String @default("rect")
  seats    Int    @default(0)
  /// "sol", "sombra" o null. En una mesa, null = el de la ventana más cercana.
  sun      String?
  /// Sector a mano ("Terraza", "Salón"). Vacío = la zona dibujada que la contiene.
  zone     String @default("")
  /// true/false fuerza "junto a ventana"; null = se calcula por cercanía.
  nearWindow Boolean?
  reservable Boolean @default(true)

  floor        Floor              @relation(fields: [floorId], references: [id], onDelete: Cascade)
  reservations TableReservation[]

  @@index([floorId])
  @@map("floor_elements")
}

model TableReservation {
  id             String   @id @default(uuid())
  businessId     String
  /// null si después se borró la mesa del croquis: la reserva queda igual.
  tableId        String?
  /// Copia del nombre de la mesa y del piso al reservar.
  tableLabel     String
  floorName      String
  conversationId String?
  contactName    String
  contactHandle  String
  partySize      Int
  /// Hora local del negocio, igual que Appointment.startsAt.
  startsAt        String
  durationMinutes Int
  status          String   @default("confirmado")
  note            String   @default("")
  /// Quién lo atiende, si el cliente pidió a alguien del equipo.
  attendantName   String?
  createdAt       DateTime @default(now())

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  table    FloorElement? @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@index([businessId, startsAt])
  @@index([tableId])
  @@map("table_reservations")
}

// --- Catálogo y pedidos ---

model Product {
  id         String  @id @default(uuid())
  businessId String
  name       String
  price      Int
  /// null = sin control de stock (siempre disponible).
  stock      Int?
  active     Boolean @default(true)

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  image    ProductImage?

  @@index([businessId])
  @@map("products")
}

/// Foto de un producto. Va en su propia tabla para que listar el catálogo no
/// arrastre los bytes de las imágenes. Se guardan ya reducidas (el navegador las
/// achica antes de subirlas), así que cabe en la base sin servicio aparte.
model ProductImage {
  productId   String   @id
  contentType String
  data        Bytes
  updatedAt   DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

/// Logo del negocio: mismo patrón que ProductImage, en su propia tabla para
/// que cargar la lista de negocios no arrastre los bytes de cada logo.
model BusinessLogo {
  businessId  String   @id
  contentType String
  data        Bytes
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_logos")
}

model Order {
  id             String   @id @default(uuid())
  businessId     String
  conversationId String?
  contactName    String
  contactHandle  String
  total          Int
  note           String   @default("")
  status         String   @default("pendiente")
  createdAt      DateTime @default(now())

  /// Cobro antes de preparar (ver lib/payments.ts): no_aplica | esperando |
  /// revisar (el cliente dice que pagó) | pagado | vencido.
  paymentStatus   String    @default("no_aplica")
  /// transferencia | mercadopago (cómo quedó pagado).
  paymentMethod   String?
  /// Si no se paga antes de esto, se anula y el stock vuelve.
  paymentDeadline DateTime?
  paymentLink     String?
  paidAt          DateTime?
  /// Cuándo salió el ticket en la pantalla de cocina. null = falta imprimir.
  kitchenPrintedAt DateTime?
  /// Lo que se leyó del comprobante y cómo se cruzó con el pedido (ver lib/receipts.ts).
  receiptCheck    Json?
  /// Código de operación del comprobante: uno repetido es señal de trampa.
  receiptCode     String?
  receipt         OrderReceipt?

  business Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items    OrderItem[]

  @@index([businessId, createdAt])
  @@index([businessId, receiptCode])
  @@map("orders")
}

model OrderItem {
  id        String @id @default(uuid())
  orderId   String
  /// No es una FK a propósito: si el producto se borra, el pedido conserva
  /// el nombre y precio que tenía en ese momento (ya están en name/unitPrice).
  productId String
  name      String
  unitPrice Int
  quantity  Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

/// Aviso del dueño de la plataforma a sus clientes (mantenimiento, reparaciones,
/// novedades). Se muestra como un banner en el panel mientras esté activo.
model Announcement {
  id        String   @id @default(uuid())
  message   String
  /// info | warning | maintenance
  level     String   @default("info")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([active, createdAt])
  @@map("announcements")
}

/// Ajustes globales de la plataforma (clave -> valor), p. ej. el modo mantenimiento.
model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

/// Cobros, cocina e inventario de un negocio que vende (comida, tienda). Todo
/// viene apagado: cada negocio activa lo que le sirve.
model SalesSettings {
  businessId String @id

  /// Pedir el pago antes de preparar.
  paymentsEnabled     Boolean @default(false)
  /// Datos para transferir (banco, tipo y número de cuenta, RUT, nombre, mail).
  transferInfo        String  @default("")
  /// Minutos que se guarda un pedido sin pagar antes de anularlo.
  holdMinutes         Int     @default(20)
  /// Access token de Mercado Pago del negocio, cifrado (lib/secrets.ts).
  /// null = solo transferencia.
  mercadoPagoToken    String?
  /// Pantalla de cocina con impresión de tickets.
  kitchenEnabled      Boolean @default(false)
  /// Confirmar el pago solo cuando el comprobante calza en todo (riesgoso:
  /// una imagen editada puede pasar). Apagado por defecto.
  autoConfirmReceipts Boolean @default(false)
  /// Avisar cuando un producto baja del mínimo o se agota.
  stockAlertsEnabled  Boolean @default(false)
  stockAlertThreshold Int     @default(5)
  updatedAt           DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("sales_settings")
}

/// Imagen del comprobante que mandó el cliente, para que el local la vea.
/// En su propia tabla: listar pedidos no arrastra los bytes.
model OrderReceipt {
  orderId     String   @id
  contentType String
  data        Bytes
  createdAt   DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_receipts")
}

// --- API v1 de solo lectura (Houston Ops) ---

/// Clave de acceso a /api/v1. Se guarda solo el hash (SHA-256): la clave en
/// texto se muestra una vez al crearla. `revokedAt` en el futuro = período de
/// gracia al rotar: la clave vieja sigue sirviendo hasta esa hora.
model ApiKey {
  id          String    @id @default(uuid())
  name        String
  /// Primeros caracteres, para reconocerla en el panel sin exponerla.
  prefix      String
  keyHash     String    @unique
  scope       String    @default("read")
  createdAt   DateTime  @default(now())
  createdById String?
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  accessLogs ApiAccessLog[]

  @@map("api_keys")
}

/// Cada pedido a /api/v1 (también los rechazados). Sin cuerpos ni parámetros
/// sensibles: solo qué se pidió, quién y cómo terminó.
model ApiAccessLog {
  id        String   @id @default(uuid())
  keyId     String?
  keyPrefix String?
  method    String
  path      String
  status    Int
  ip        String?
  at        DateTime @default(now())

  key ApiKey? @relation(fields: [keyId], references: [id], onDelete: SetNull)

  @@index([at])
  @@index([keyId, at])
  @@map("api_access_logs")
}

/// Suscripción de un usuario en Stripe (se llena desde el webhook firmado).
model Subscription {
  id                 String    @id // id de la suscripción en Stripe
  userId             String
  plan               String
  /// Estado de Stripe: active | trialing | past_due | unpaid | canceled | ...
  status             String
  amountClp          Int
  currentPeriodEnd   DateTime?
  canceledAt         DateTime?
  /// Desde cuándo está impaga (primer cobro fallido sin resolver).
  pastDueSince       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("subscriptions")
}

/// Un pago recibido (Stripe `invoice.paid`). Montos en CLP, enteros.
model Payment {
  id               String   @id @default(uuid())
  stripeInvoiceId  String   @unique
  userId           String?
  amountClp        Int
  method           String
  status           String   @default("pagado")
  paidAt           DateTime
  createdAt        DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([paidAt])
  @@map("payments")
}

/// Factura de cobro (Stripe). `folio` y `siiStatus` quedan vacíos hasta que
/// haya un emisor de DTE conectado: no se inventan.
model Invoice {
  id              String    @id @default(uuid())
  stripeInvoiceId String    @unique
  userId          String?
  number          String?
  folio           String?
  siiStatus       String?
  amountClp       Int
  /// pagada | pendiente | vencida | anulada
  status          String
  issuedAt        DateTime
  dueDate         DateTime?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([issuedAt])
  @@map("invoices")
}

/// Fallos de integración (WhatsApp, Instagram, IA, pagos). Sin datos de
/// clientes finales: solo origen, gravedad y un motivo sin claves.
model Incident {
  id         String   @id @default(uuid())
  source     String
  severity   String
  code       String
  message    String
  businessId String?
  occurredAt DateTime @default(now())

  @@index([occurredAt])
  @@index([source, occurredAt])
  @@map("incidents")
}
