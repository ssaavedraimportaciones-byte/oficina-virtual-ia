# Claude (Anthropic) — motor del agente conversacional
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# WhatsApp Cloud API (Meta) — panel > Conexiones muestra cómo completar esto
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Instagram Messaging (Meta Graph API, misma app que WhatsApp)
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_PAGE_ID=

# App
NEXT_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AgentsApp
