# --- Motor de IA ---
# Alcanza con configurar UNO de los dos proveedores.
# Si cargás los dos, LLM_PROVIDER define cuál se usa (por defecto, anthropic).
# LLM_PROVIDER=anthropic | openai
LLM_PROVIDER=

# Opción A — Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Opción B — OpenAI (platform.openai.com)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Opción C — cualquier IA compatible con OpenAI: un modelo LOCAL (Ollama,
# LM Studio, vLLM) o un servicio con capa gratuita (Groq, Gemini, OpenRouter…).
# Poner LLM_PROVIDER=openai, la URL del servidor y el nombre del modelo.
# Ej. Ollama local: OPENAI_BASE_URL=http://localhost:11434/v1  OPENAI_MODEL=qwen2.5:14b
# OJO: los modelos chicos o gratuitos fallan más al usar herramientas (agenda y
# pedidos), y las capas gratuitas suelen usar tus datos y limitar el uso comercial.
OPENAI_BASE_URL=

# --- Comportamiento del agente (opcional) ---
# Zona horaria de los negocios: define qué es "hoy" y "ahora" para la agenda.
# Por defecto America/Santiago. Ej: America/Argentina/Buenos_Aires.
BUSINESS_TIMEZONE=America/Santiago
# Cuánto espera el agente antes de contestar, por si el cliente manda varios
# mensajes seguidos (así contesta una vez a toda la ráfaga). En milisegundos.
AGENT_DEBOUNCE_MS=2500
# Solo para una instalación de UN negocio (no SaaS): atribuye al único negocio
# los mensajes de números que todavía no cargó. Dejalo apagado en multi-empresa.
SINGLE_BUSINESS_MODE=false

# --- Cupo de respuestas del agente por empresa (multi-empresa) ---
# Todas las empresas comparten tu clave de IA: este tope por mes evita que una
# sola te agote el saldo. Se cuenta por empresa y se renueva el día 1; el plan
# sale del DUEÑO de la empresa. Un valor negativo = sin límite.
AGENT_REPLIES_FREE=300
AGENT_REPLIES_PRO=5000

# --- Seguridad (obligatorio en producción) ---
# Cifra los tokens de Meta guardados. Sin esto no se pueden conectar canales.
# Generala con: openssl rand -hex 32
ENCRYPTION_KEY=

# App Secret de tu app de Meta. Se usa para verificar la firma de los webhooks.
# Sin esto los webhooks se rechazan, para que nadie inyecte mensajes falsos.
META_APP_SECRET=

# --- Canales ---
# WhatsApp Cloud API (Meta) — el panel > Conexiones explica cómo completarlo
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Instagram Messaging (Meta Graph API, misma app que WhatsApp)
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_PAGE_ID=

# --- Email (opcional, pero recomendado) ---
# Sin esto, "recuperar contraseña" y "verificar email" no mandan mails —
# el admin puede igual restablecer una contraseña a mano desde /admin.
# Sirve cualquier proveedor SMTP (Gmail, SendGrid, Mailgun, Amazon SES, etc.).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ZeroVisto <no-responder@tudominio.com>"

# --- Facturación (opcional) ---
# Sin esto todos los usuarios quedan en el plan FREE (1 negocio propio) y no
# se puede pasar a PRO. dashboard.stripe.com > Developers > API keys / Webhooks.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ID (no Product ID) del plan PRO, modo suscripción.
STRIPE_PRICE_ID_PRO=

# --- Base de datos ---
# En Supabase/Vercel: DATABASE_URL usa el pool transaccional (puerto 6543) y
# DIRECT_URL usa el pool de sesión (puerto 5432) únicamente para migraciones.
DATABASE_URL=postgresql://usuario.proyecto:password@pooler:6543/postgres?sslmode=require&uselibpqcompat=true
DIRECT_URL=postgresql://usuario.proyecto:password@pooler:5432/postgres?sslmode=require

# --- Registro abierto (multi-empresa) ---
# Apagado por defecto. Con true, cualquiera puede crear una cuenta en /registro
# (plan gratis, un negocio) y el botón "Probar gratis" de la portada funciona.
# Actívalo cuando tengas definidos precios, cupos de respuestas y soporte.
ALLOW_SIGNUP=false

# --- Primer usuario ---
# Se crea automáticamente como admin de plataforma en el primer login, si
# todavía no existe ningún usuario. Después de eso podés (y conviene) borrar
# estas dos variables: el resto de los usuarios se crean desde /admin.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- App ---
NEXT_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ZeroVisto
