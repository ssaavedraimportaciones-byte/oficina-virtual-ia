# Conexión con el rol dueño (migraciones y tests)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pronex_test
# Contraseña que los tests asignan al rol pronex_app
PRONEX_APP_PASSWORD=pronex_app_test
# API
APP_DATABASE_URL=postgres://pronex_app:pronex_app_test@localhost:5432/pronex_test
OIDC_ISSUER=https://tu-tenant.auth0.com/
OIDC_AUDIENCE=pronex-api
REDIS_URL=redis://localhost:6379
# WhatsApp (si falta META_APP_SECRET el canal queda deshabilitado)
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# 32 bytes en base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PRONEX_SECRET_KEY=
